# Supabase Dashboard > Project Settings > API
# Project URL 과 anon public key 를 아래에 붙여넣으세요.
#
# 예:
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 저장 후 반드시 재시작: npm run dev

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 빌드 채널 (test | preview | production). production 이면 상단 배너 숨김.
# VITE_APP_CHANNEL=test
# VITE_APP_VERSION=0.1.0

# --- 이메일 알림 (Supabase Edge Function secrets, 프론트엔드에 넣지 마세요) ---
# Dashboard > Edge Functions > Secrets 에 설정:
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=교회 방 예약 <noreply@yourdomain.com>
# SITE_NAME=교회 방 예약
# REMINDER_TIMEZONE=Pacific/Auckland
# CRON_SECRET=긴_랜덤_문자열
# APP_ORIGIN=https://your-production-domain.com
#
# 배포:
#   supabase functions deploy send-reservation-email
#   supabase functions deploy send-reservation-reminders
#   supabase db push   # 008_reservation_emails.sql + 009_security_hardening.sql
#
# 하루 전 알림: Dashboard > Edge Functions > Schedules
#   Function: send-reservation-reminders
#   Cron: 0 9 * * *  (매일 오전 9시)
#   Authorization: Bearer <CRON_SECRET 또는 service role key>
#
# Auth > URL Configuration 에서 Site URL / Redirect URLs 를 프로덕션 도메인으로 고정하세요.
